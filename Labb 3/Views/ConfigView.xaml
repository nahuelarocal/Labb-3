<UserControl x:Class="Labb_3.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="Quiz configurator" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Create and manage your quiz packs."
                       FontSize="15" Foreground="#666666" Margin="0,4,0,24" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" Padding="20">
                    <StackPanel>
                        <TextBlock Text="My question packs" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                        <ListBox MinHeight="220">
                            <ListBoxItem Content="General knowledge" />
                            <ListBoxItem Content="Programming" />
                            <ListBoxItem Content="History" />
                        </ListBox>
                        <Button Content="Create new pack" Padding="12" Margin="0,12,0,0" />
                        <Button Content="Remove selected pack" Padding="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Questions in the pack" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                        <ListBox MinHeight="220">
                            <ListBoxItem Content="1. What is the capital of Sweden?" />
                            <ListBoxItem Content="2. Which language is used with WPF?" />
                        </ListBox>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Add question" Padding="12" Margin="0,0,8,8" />
                            <Button Content="Edit question" Padding="12" Margin="0,0,8,8" />
                            <Button Content="Remove question" Padding="12" Margin="0,0,8,8" />
                            <Button Content="Pack settings" Padding="12" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
