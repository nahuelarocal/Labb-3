<UserControl x:Class="Labb_3.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource PageBackground}">
        <StackPanel Margin="36">
            <TextBlock Text="Build your quiz" FontSize="30" FontWeight="Bold" Foreground="#2F075F" />
            <TextBlock Text="Create question packs and get ready to play."
                       FontSize="15" Foreground="#746B80" Margin="0,4,0,24" />
            <WrapPanel Margin="0,0,0,20">
                <Button Content="Save packs" Height="40" Margin="0,0,8,0"
                        Click="SavePacksButton_Click" />
                <Button Content="Load packs" Background="#18A999" Height="40"
                        Click="LoadPacksButton_Click" />
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E5DCEE"
                        BorderThickness="1" CornerRadius="14" Padding="22">
                    <StackPanel>
                        <TextBlock Text="My question packs" FontSize="20" FontWeight="Bold"
                                   Foreground="#2F075F" Margin="0,0,0,14" />
                        <ListBox x:Name="packList" DisplayMemberPath="Name"
                                 MinHeight="220" BorderBrush="#E5DCEE" Padding="4"
                                 SelectionChanged="PackList_SelectionChanged" />
                        <Button Content="+  Create new pack" Height="44" Margin="0,14,0,0"
                                Click="CreatePackButton_Click" />
                        <Button Content="Remove selected pack" Background="#EEEAF3"
                                Foreground="#51465E" Height="40" Margin="0,8,0,0"
                                Click="RemovePackButton_Click" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E5DCEE"
                        BorderThickness="1" CornerRadius="14" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Questions in the pack" FontSize="20" FontWeight="Bold"
                                   Foreground="#2F075F" Margin="0,0,0,14" />
                        <ListBox x:Name="questionList" DisplayMemberPath="Text"
                                 MinHeight="220" BorderBrush="#E5DCEE" Padding="4" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Add question" Height="42" Margin="0,0,8,8"
                                    Click="AddQuestionButton_Click" />
                            <Button Content="Edit question" Background="#EEEAF3" Foreground="#51465E"
                                    Height="42" Margin="0,0,8,8" Click="EditQuestionButton_Click" />
                            <Button Content="Remove question" Background="#D9435F" Height="42" Margin="0,0,8,8"
                                    Click="RemoveQuestionButton_Click" />
                            <Button Content="Pack settings" Background="#18A999" Height="42" Margin="0,0,8,8"
                                    Click="PackSettingsButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
