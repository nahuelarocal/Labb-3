<UserControl x:Class="Labb_3.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F2F2F2">
        <StackPanel Width="650" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Question 1 of 2" HorizontalAlignment="Center" FontSize="16" Foreground="#666666" />
            <TextBlock Text="What is the capital of Sweden?" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="28" FontWeight="Bold" Margin="0,16,0,24" />
            <Button Content="Oslo" Padding="14" Margin="0,0,0,10" />
            <Button Content="Stockholm" Padding="14" Margin="0,0,0,10" />
            <Button Content="Copenhagen" Padding="14" Margin="0,0,0,10" />
            <Button Content="Helsinki" Padding="14" />
        </StackPanel>
    </Grid>
</UserControl>
