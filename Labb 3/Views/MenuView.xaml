<UserControl x:Class="Labb_3.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" Padding="12">
        <DockPanel>
            <TextBlock Text="Quiz Configurator" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="8,0,24,0" />
            <StackPanel Orientation="Horizontal">
                <Button Content="File" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Edit" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Play" Padding="14,7" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
