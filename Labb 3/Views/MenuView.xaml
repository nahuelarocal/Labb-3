<UserControl x:Class="Labb_3.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#2F075F" Padding="16">
        <DockPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,32,0">
                <TextBlock Text="QUIZ" FontSize="19" FontWeight="Bold" Foreground="White" />
                <TextBlock Text=" LAB" FontSize="19" FontWeight="Bold" Foreground="#FFD23F" />
            </StackPanel>
            <Menu Background="#2F075F" Foreground="White" VerticalAlignment="Center">
                <MenuItem Header="_File" Foreground="White">
                    <MenuItem Header="_Save packs" Foreground="#2F075F" InputGestureText="Ctrl+S" Click="SavePacksMenuItem_Click" />
                    <MenuItem Header="_Load packs" Foreground="#2F075F" InputGestureText="Ctrl+O" Click="LoadPacksMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="_Import questions" Foreground="#2F075F" Click="ImportQuestionsMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="_Edit" Foreground="White">
                    <MenuItem Header="_Configure" Foreground="#2F075F" Click="ConfigureMenuItem_Click" />
                    <MenuItem Header="Pack _options" Foreground="#2F075F" Click="PackOptionsMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="_Play" Foreground="#FFD23F">
                    <MenuItem Header="_Start quiz" Foreground="#2F075F" Click="PlayMenuItem_Click" />
                </MenuItem>
            </Menu>
        </DockPanel>
    </Border>
</UserControl>
