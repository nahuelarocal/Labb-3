<Window x:Class="Labb_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Labb_3.Views"
        mc:Ignorable="d"
        Title="Quiz Configurator" Height="650" Width="1000"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <views:MenuView Grid.Row="0" />
        <Grid Grid.Row="1">
            <views:ConfigView x:Name="configView" />
            <views:PlayView x:Name="playView" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
