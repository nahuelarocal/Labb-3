<Window x:Class="Labb_3.Dialogs.ImportQuestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import questions" Height="390" Width="460"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <StackPanel Margin="24">
        <TextBlock Text="Import questions from OpenTDB" FontSize="20" FontWeight="Bold" Margin="0,0,0,18" />
        <TextBlock Text="Category" />
        <ComboBox x:Name="categoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                  Margin="0,6,0,14" Padding="7" />
        <TextBlock Text="Difficulty" />
        <ComboBox x:Name="difficultyBox" SelectedIndex="0" Margin="0,6,0,14" Padding="7">
            <ComboBoxItem Content="Easy" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="Hard" />
        </ComboBox>
        <TextBlock Text="Number of questions (1–50)" />
        <TextBox x:Name="amountBox" Text="5" Margin="0,6,0,14" Padding="7" />
        <TextBlock x:Name="statusText" TextWrapping="Wrap" Foreground="#746B80" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="12,7" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="importButton" Content="Import" Padding="12,7" Click="ImportButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
