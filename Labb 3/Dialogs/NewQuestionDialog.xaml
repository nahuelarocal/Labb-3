<Window x:Class="Labb_3.Dialogs.NewQuestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New question" Height="480" Width="500"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock x:Name="titleText" Text="Create a new question" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
            <TextBlock Text="Question" />
            <TextBox x:Name="questionTextBox" Margin="0,6,0,14" Padding="7" />
            <TextBlock Text="Answer choices" FontWeight="Bold" />
            <TextBox x:Name="answer1Box" Margin="0,6,0,8" Padding="7" />
            <TextBox x:Name="answer2Box" Margin="0,0,0,8" Padding="7" />
            <TextBox x:Name="answer3Box" Margin="0,0,0,8" Padding="7" />
            <TextBox x:Name="answer4Box" Margin="0,0,0,14" Padding="7" />
            <TextBlock Text="Correct answer" />
            <ComboBox x:Name="correctAnswerBox" SelectedIndex="0" Margin="0,6,0,20" Padding="7">
                <ComboBoxItem Content="Answer 1" />
                <ComboBoxItem Content="Answer 2" />
                <ComboBoxItem Content="Answer 3" />
                <ComboBoxItem Content="Answer 4" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="12,7" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button Content="Save question" Padding="12,7" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
