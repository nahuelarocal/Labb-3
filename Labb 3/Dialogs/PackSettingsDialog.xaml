<Window x:Class="Labb_3.Dialogs.PackSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pack settings" Height="360" Width="420"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="Pack settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
        <TextBlock Text="Pack name" />
        <TextBox x:Name="packNameBox" Margin="0,6,0,14" Padding="7" />
        <TextBlock Text="Difficulty" />
        <ComboBox x:Name="difficultyBox" SelectedValuePath="Content" Margin="0,6,0,14" Padding="7">
            <ComboBoxItem Content="Easy" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="Hard" />
        </ComboBox>
        <TextBlock Text="Seconds for each question" />
        <TextBox x:Name="secondsBox" Margin="0,6,0,20" Padding="7" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="12,7" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Save" Padding="12,7" Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
